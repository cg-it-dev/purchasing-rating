<html lang='id'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>
    <link rel='stylesheet' href='/css/style.css' />
  </head>
  <body>
    <div class='container'>
      <h1>Selamat Datang, {{user.name}}!</h1>
      <p>Email: {{user.email}}</p>
      <p>Group: {{user.groups}}</p>

      <hr />

      <h2>Form Penilaian Purchasing</h2>
      <form action='/rating/create' method='POST'>
        <div>
          <label for='rating'>Nilai:</label>
          <input
            type='number'
            id='rating'
            name='score'
            min='1'
            max='5'
            required
          />
        </div>
        <div>
          <label for='comment'>Catatan:</label>
          <textarea id='comment' name='comment'></textarea>
        </div>
        <button type='submit'>Kirim Penilaian</button>
      </form>

      <hr />

      <h2>Riwayat Penilaian</h2>
      <ul>
        {{#each listPenilaian}}
          <li>
            <strong>Score: {{this.score}}</strong>
            -
            {{this.comment}}
          </li>
        {{else}}
          <li>Belum ada data penilaian.</li>
        {{/each}}
      </ul>
    </div>
  </body>
</html>